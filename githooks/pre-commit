#!/usr/bin/env bash
#
# Hook de pre-commit — os três portões de cadência de commit, e nada além.
#
# Instalação, opt-in e por repositório:
#
#     git config core.hooksPath githooks
#
# Os worktrees de `.claude/worktrees/` herdam a configuração, então instalar uma
# vez cobre também o que os subagentes commitam.
#
# ---
#
# O HOOK LOCAL NÃO É O PORTÃO, É O ATALHO.
#
# Ele roda os portões 1, 2 e 3 — os três de cadência de commit, os três que
# varrem CSS com `grep` e fecham em ~2s. O que ele compra é a distância até o
# erro: descobrir um literal de cor fora de `tokens.css` aqui custa um segundo,
# e descobrir na CI custa um push, uma run e um turno.
#
# `--no-verify` é PERMITIDO, e não abre buraco nenhum. Quem barra é o ruleset da
# `main` — `bypass_actors` vazio, o check `gate` required, `strict` ligado —, e
# ruleset não tem `--no-verify`. Um hook local pulável e um ruleset sem bypass
# são a mesma decisão vista de dois lados: a máquina cobra num lugar só, e o
# lugar é aquele por onde o código precisa passar.
#
# O que ele deliberadamente NÃO roda: o portão 4 (contagem de conteúdo) e o 5 (a
# referência gerada, que invoca `node` e `git diff`) dominam os ~2,5s do bundle
# `npm run portoes`, e nenhum dos dois é frequente o bastante para pagar o custo
# em todo commit. Eles ficam na CI, que é onde a cobrança vale.
#
# Zero dependência nova, como todo o resto: nada de `lefthook`, nada de
# `commitlint`. Este arquivo é bash, e os três portões são os que já existem.

set -euo pipefail

cd "$(git rev-parse --show-toplevel)"

falhou=0

for portao in 1 2 3; do
  if ! npm run --silent "portao:${portao}"; then
    falhou=1
  fi
done

if [ "${falhou}" -ne 0 ]; then
  echo
  echo "pre-commit: portão de commit reprovou. Corrija, ou passe --no-verify e"
  echo "responda ao mesmo portão na CI — o ruleset da main não deixa passar."
  exit 1
fi
